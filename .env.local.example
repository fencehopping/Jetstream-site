# Local development secrets for Jetstream pre-launch site.
# Duplicate this file as .env.local, then replace each placeholder.

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PUB_API_KEY=your-supabase-publishable-or-anon-key
SUPABASE_LEGACY_API_KEY=your-supabase-legacy-anon-key
SUPABASE_WAITLIST_TABLE=waitlist_signups

# Resend
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Jetstream <onboarding@yourdomain.com>
WAITLIST_NOTIFY_TO_EMAIL=nick@shedlabs.studio
